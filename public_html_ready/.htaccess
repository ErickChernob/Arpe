# ARPE static site - Apache configuration
# Safe to place at the web root (public_html) alongside index.html.

# ------------------------------------------------------------------
# Custom error document
# ------------------------------------------------------------------
ErrorDocument 404 /404.html

# ------------------------------------------------------------------
# Prevent directory listing
# ------------------------------------------------------------------
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # ----------------------------------------------------------------
  # Force HTTPS. Checks both %{HTTPS} and X-Forwarded-Proto, since
  # some hosts/proxies (including some shared-hosting setups and
  # CDNs) terminate TLS upstream and always report HTTPS=off
  # internally -- checking only %{HTTPS} in that setup causes an
  # infinite redirect loop.
  # ----------------------------------------------------------------
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # ----------------------------------------------------------------
  # Force non-www (matches the canonical/OG domain used throughout
  # this site: https://arpesa.com.mx/). Remove this block if the
  # client prefers the www subdomain instead.
  # ----------------------------------------------------------------
  RewriteCond %{HTTP_HOST} ^www\.arpesa\.com\.mx$ [NC]
  RewriteRule ^ https://arpesa.com.mx%{REQUEST_URI} [L,R=301]

  # ----------------------------------------------------------------
  # Optional clean URLs: allow /nosotros to resolve to /nosotros.html
  # without changing any existing .html links or the canonical tags
  # (which still point at the .html URLs). Purely additive/optional.
  # ----------------------------------------------------------------
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^([^.]+)$ $1.html [NC,L]

  # ----------------------------------------------------------------
  # Legacy Webflow path redirects: add 301s here if the client
  # identifies old inbound links that used a different URL structure
  # (e.g. a Webflow staging subdomain). None were found in this
  # export, so none are hardcoded. Example:
  # RewriteRule ^old-page$ /new-page.html [R=301,L]
  # ----------------------------------------------------------------
</IfModule>

# ------------------------------------------------------------------
# Basic static asset caching (safe defaults; adjust as needed)
# ------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType font/woff2 "access plus 1 month"
</IfModule>

# ------------------------------------------------------------------
# Compression (safe, standard text-asset gzip; no effect on already
# compressed binaries like images/fonts, which are excluded)
# ------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ------------------------------------------------------------------
# Security headers safe for a static site (no inline-script/CSP
# lockdown here, since that requires auditing every inline <script>
# and is easy to get wrong and break the site -- left as a manual,
# deliberate follow-up rather than guessed at automatically here).
# ------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>
